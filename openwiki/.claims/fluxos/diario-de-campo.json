    {
      "id": "claim_690459b133054e4c9b625f507e263486",
      "statement": "Which calendar-month folder a week's diary file belongs to is decided by the 'Wednesday rule': a Monday-Friday week belongs to the month containing its Wednesday (equivalently, the month holding the majority of its 5 weekdays), while the file name always keeps the opening Monday's date regardless of which month folder it lands in.",
      "evidence": [
        {
          "resource": "repo://research-diary/README.md#L29-L29",
          "version": "repo-lines-v1:sha256:e2d259929932c75ae8ebcc1f8ffc4db550f2955264eac9e6a73a2bcb4f14a031:"
