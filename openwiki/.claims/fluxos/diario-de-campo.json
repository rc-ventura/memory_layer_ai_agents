  "claims": [
    {
      "id": "claim_61bcf96cd5864930bc41560bea599df9",
      "statement": "The research diary is deliberately structured as a miniature application of the same memory theory the project studies: an episodic layer (raw daily entries, cheap to write) that is never rewritten or summarized in place, and a derived, regenerable semantic layer (periodic distilled synthesis).",
      "evidence": [
        {
          "resource": "repo://research-diary/README.md#L7-L7",
          "version": "repo-lines-v1:sha256:ebe16c2a601de1492faf2fecc6c097fb9af18730f279e97583e209ef399af71d:"
        }
      ]
    },
    {
      "id": "claim_e386df35d3f747d7b7e76b2dfc57f9af",
      "statement": "Starting 24/08/2026, the diary uses one file per week named diario_campo_AAAA-MM-DD.md (AAAA-MM-DD is the opening Monday), and the diary week runs Monday-Friday only (5 working days), holding only episodic entries.",
      "evidence": [
        {
          "resource": "repo://research-diary/README.md#L17-L17",
          "version": "repo-lines-v1:sha256:db1104cd0271192bff316943828ac496c61a40eddf984d7cde66e169559c7790:"
