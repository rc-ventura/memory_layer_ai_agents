  "claims": [
    {
      "id": "claim_9b4219f67448476ebdc33ce5d7ec6283",
      "statement": "analysis/ analyses aim to build an empirical bridge between the raw trace of a real agent system, the actual mechanisms of failure visible in it, and the smallest reusable lesson/memory/operational correction that could prevent the same failure from recurring.",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L25-L35",
          "version": "repo-lines-v1:sha256:9af0912454c4f3423fa2795dc9c30324b807df437401dc0e39a65e847a9c8ea5:"
        }
      ]
    },
    {
      "id": "claim_3b4a96f3c0724ac4bb83f1cbbf377026",
      "statement": "The project's rule of thumb for validation depth is that direct counts are often robust by construction (independent recomputation suffices), heuristic-dependent claims need robustness testing against plausible alternatives, and prescriptive/causal/memory-bearing claims require the strongest treatment (raw-case evidence packs, rule-based case selection, independent audit reports).",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L107-L117",
          "version": "repo-lines-v1:sha256:a1d8d58262ae2272094cdd23693709e442b26da1033e701e936ca9d1af45d6ef:"
        }
      ]
    },
    {
      "id": "claim_a43e1ec47a4e447f90d990eeb14abc89",
      "statement": "The project distinguishes derived artifacts (compact views for navigation/aggregation) from evidence packs (analysis-specific folders preserving the link back to selected raw cases) and independent audit reports (a second reading that checks whether an analysis claim holds when reopened from the raw trace), because code can be wrong in a perfectly consistent way.",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L119-L130",
          "version": "repo-lines-v1:sha256:903335ff11a19bf42154ef23175833e6b4d0feda8e3f75c97642d7ac6331bd98:"
        }
      ]
    },
    {
      "id": "claim_daf5fe8eccc5492ba7ff83ee1a534395",
      "statement": "Derived CSVs under resultados/ are always git-ignored because they carry client names, case numbers, and document excerpts in the clear and must be regenerated by running the notebook; raw trace files (*.csv.xz) must never be committed in the clear anywhere in the repository because they contain unanonymized legal-case data.",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L16-L21",
          "version": "repo-lines-v1:sha256:ff61f66c80983aa833889e507915d4e1ccefc348e6ddd446ddaded588f118b5e:"
        }
