    {
      "id": "claim_9b4219f67448476ebdc33ce5d7ec6283",
      "statement": "analysis/ analyses aim to build an empirical bridge between the raw trace of a real agent system, the actual mechanisms of failure visible in it, and the smallest reusable lesson/memory/operational correction that could prevent the same failure from recurring.",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L25-L35",
