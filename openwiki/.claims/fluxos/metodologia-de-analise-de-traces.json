        }
      ]
    },
    {
      "id": "claim_3b4a96f3c0724ac4bb83f1cbbf377026",
      "statement": "The project's rule of thumb for validation depth is that direct counts are often robust by construction (independent recomputation suffices), heuristic-dependent claims need robustness testing against plausible alternatives, and prescriptive/causal/memory-bearing claims require the strongest treatment (raw-case evidence packs, rule-based case selection, independent audit reports).",
      "evidence": [
        {
          "resource": "repo://analysis/README.md#L107-L117",
          "version": "repo-lines-v1:sha256:a1d8d58262ae2272094cdd23693709e442b26da1033e701e936ca9d1af45d6ef:"
        }
      ]
    },
    {
      "id": "claim_a43e1ec47a4e447f90d990eeb14abc89",
      "statement": "The project distinguishes derived artifacts (compact views for navigation/aggregation) from evidence packs (analysis-specific folders preserving the link back to selected raw cases) and independent audit reports (a second reading that checks whether an analysis claim holds when reopened from the raw trace), because code can be wrong in a perfectly consistent way.",
      "evidence": [
